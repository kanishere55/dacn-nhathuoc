DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_HIEN_NHAN_DIEN_TRANG=True
POSTGRES_DB=dacn_nhathuoc
POSTGRES_USER=dacn_ung_dung
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
REDIS_URL=redis://127.0.0.1:6379/0
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_DI_BO_BASE_URL=https://routing.openstreetmap.de/routed-foot
# Điền đường dẫn DLL nếu GeoDjango trên Windows không tự tìm được.
GDAL_LIBRARY_PATH=
GEOS_LIBRARY_PATH=

# Tên thương hiệu và địa chỉ công khai của website, dùng trong email và cổng thanh toán.
TEN_THUONG_HIEU=Nhà thuốc Tâm An
URL_WEBSITE=http://127.0.0.1:8000

# Email gửi qua Gmail SMTP. Mật khẩu là mật khẩu ứng dụng 16 ký tự, không phải mật khẩu Gmail.
# Bỏ trống thì email được in ra console.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_GUI_NEN=True

# Chuyển khoản VietQR. Mã BIN theo danh sách ngân hàng của NAPAS, ví dụ 970436 là Vietcombank.
# Bỏ trống thì trang đặt hàng ẩn hình thức chuyển khoản.
NGAN_HANG_BIN=
TEN_NGAN_HANG=
SO_TAI_KHOAN=
TEN_TAI_KHOAN=
# Khóa API webhook của SePay để tự xác nhận tiền vào. Bỏ trống thì nhân viên xác nhận tay.
SEPAY_API_KEY=

# Ví MoMo (cổng captureWallet v2). Dùng thông tin sandbox ở môi trường thử.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn
